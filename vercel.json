{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "server-stripe.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/create-checkout-session",
      "dest": "/server-stripe.js"
    },
    {
      "src": "/webhook",
      "dest": "/server-stripe.js"
    },
    {
      "src": "/(.*)",
      "dest": "/server.js"
    }
  ]
}
