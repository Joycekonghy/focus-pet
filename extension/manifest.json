{
  "manifest_version": 3,
  "name": "Focus Pet",
  "version": "1.0",
  "description": "Your virtual pet companion that reacts to your browsing habits",
  
  "permissions": [
    "activeTab",
    "storage",
    "tabs"
  ],
  
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["pet.css"],
      "run_at": "document_end"
    }
  ],
  
  "background": {
    "service_worker": "background.js"
  },
  
  "action": {
    "default_popup": "popup.html",
    "default_title": "Focus Pet Settings"
  }
}
